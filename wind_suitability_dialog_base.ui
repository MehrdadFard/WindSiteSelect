              <width>150</width>
              <height>36</height>
             </size>
            </property>
            <property name="font">
             <font>
              <bold>true</bold>
             </font>
            </property>
            <property name="text">
             <string>Run MCA Analysis</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QProgressBar" name="progress_mca">
            <property name="value">
             <number>0</number>
            </property>
           </widget>
          </item>
         </layout>
        </item>
       </layout>
      </widget>
     </item>
     <item>
      <widget class="QGroupBox" name="groupBox_mca_log">
       <property name="title">
