     <item>
      <widget class="QGroupBox" name="groupBox_mca_export">
       <property name="title">
        <string>4. Export &amp; Save Results</string>
       </property>
       <layout class="QHBoxLayout" name="horizontalLayout_mca_export">
        <item>
         <layout class="QVBoxLayout" name="verticalLayout_export_checks">
          <property name="spacing">
           <number>4</number>
          </property>
          <item>
           <widget class="QCheckBox" name="chk_export_ranked_grid">
